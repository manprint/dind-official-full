# The DENY_NETWORK of a dind-env compose, enforced on the host at every boot
# (scripts/host-deny.sh: the host's firewall starts empty).
#
#   sudo install -m 0755 scripts/host-deny.sh /usr/local/sbin/dind-env-host-deny
#   sudo install -m 0644 scripts/host-deny.service /etc/systemd/system/dind-env-host-deny.service
#   sudo systemctl edit dind-env-host-deny     # set COMPOSE, see below
#   sudo systemctl enable --now dind-env-host-deny
#
# Before docker.service: the container comes back with the daemon (restart:
# unless-stopped), and the rules must already be there. dockerd keeps a
# DOCKER-USER chain it finds. `docker compose config` reads the file only, it
# needs no daemon. One unit per compose: copy it under another name for a
# second instance (another COMPOSE, another bridge name).
[Unit]
Description=dind-env DENY_NETWORK on the host bridge
Before=docker.service
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The compose file whose DENY_NETWORK and bridge name are applied.
Environment=COMPOSE=/path/to/compose.yml
ExecStart=/usr/local/sbin/dind-env-host-deny apply -f ${COMPOSE}

[Install]
WantedBy=docker.service
